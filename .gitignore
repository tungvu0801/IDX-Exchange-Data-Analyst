# MLS data files (raw monthly + combined outputs) are too large for GitHub's 100 MB file limit
*.csv
csv/
output/

# Downloader working folders: in-progress downloads and backups of replaced raw files
downloads_tmp/
backup/

# Local credentials - never commit
.env

# Tableau workbooks and extracts embed MLS data (packaged workbooks and extracts hold the rows;
# plain .twb files can hold dimension values such as aliases) - never commit
*.twbx
*.twb
*.hyper
*.tde

__pycache__/
